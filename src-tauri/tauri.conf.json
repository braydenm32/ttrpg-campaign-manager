{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "The Warded Atlas",
  "version": "0.1.0",
  "identifier": "io.github.braydenm32.campaigncodex",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "The Warded Atlas",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'wasm-unsafe-eval'", "blob:", "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.0-dev.20260914-8d85527a0/dist/"],
        "worker-src": ["'self'", "blob:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "data:",
          "blob:",
          "https://ysrxumagiiaoihlhofqt.supabase.co",
          "wss://ysrxumagiiaoihlhofqt.supabase.co",
          "https://api.anthropic.com",
          "https://api.assemblyai.com",
          "https://huggingface.co",
          "https://*.huggingface.co",
          "https://*.hf.co",
          "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.31.0-dev.20260914-8d85527a0/dist/",
          "https://packs.wardedatlas.com",
          "https://discord.com",
          "https://*.discord.com",
          "https://discordapp.com",
          "https://*.discordapp.com",
          "https://syrinscape.com",
          "https://character-service.dndbeyond.com",
          "https://www.dndbeyond.com",
          "https://pathbuilder2e.com"
        ],
        "img-src": ["'self'", "data:", "blob:", "https:"],
        "media-src": ["'self'", "blob:"],
        "font-src": ["'self'", "https://fonts.gstatic.com"],
        "style-src": ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"],
        "frame-ancestors": ["'none'"]
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
